# --------------------------------
# NOTION
# --------------------------------

NOTION_TOKEN=ntn_xxxxxxxxxxxxx

NOTION_USERS_DATA_SOURCE_ID=
NOTION_POLICIES_DATA_SOURCE_ID=
NOTION_RESOURCES_DATA_SOURCE_ID=


# --------------------------------
# GITHUB APP
# --------------------------------

GH_APP_ID=123456
GH_INSTALLATION_ID=12345678
GH_PRIVATE_KEY_PATH=./secrets/github-app.pem
# Production (Cloudflare Worker) uses the PEM contents instead of a file:
# GH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

GH_ORG=your-org-name


# --------------------------------
# APPLICATION
# --------------------------------

NODE_ENV=development

# observe: reconciliation must not perform destructive revocation.
# enforce: normal desired-state enforcement (current grant behaviour).
# Unset preserves current behaviour (grants still run; GitHub revoke is unimplemented).
# Set observe before IAM is authoritative so a later revoke implementation cannot
# strip existing access during migration.
IAM_ENFORCEMENT_MODE=observe


# --------------------------------
# SLACK
# --------------------------------
# Local: Socket Mode uses SLACK_BOT_TOKEN + SLACK_APP_TOKEN (+ signing secret).
# Production Worker HTTP: SLACK_BOT_TOKEN + SLACK_SIGNING_SECRET only.
# Do not set SLACK_APP_TOKEN as a Worker secret.

SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxx
SLACK_APP_TOKEN=xapp-xxxxxxxxxxxxx
SLACK_SIGNING_SECRET=

# --------------------------------
# NOTION INVITES
# --------------------------------

NOTION_WORKSPACE_INVITE_URL=

# --------------------------------
# FIGMA INVITES
# --------------------------------

FIGMA_INVITE_URL=

# --------------------------------
# GOOGLE DRIVE OAUTH (optional)
# --------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=http://127.0.0.1:53682/oauth2/callback