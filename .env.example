# --------------------------------
# NOTION
# --------------------------------

NOTION_TOKEN=ntn_xxxxxxxxxxxxx

NOTION_USERS_DATA_SOURCE_ID=
NOTION_POLICIES_DATA_SOURCE_ID=
NOTION_RESOURCES_DATA_SOURCE_ID=
NOTION_ACCESS_TRACKING_DATA_SOURCE_ID=


# --------------------------------
# GITHUB APP
# --------------------------------

GITHUB_APP_ID=123456
GITHUB_INSTALLATION_ID=12345678
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.pem

GITHUB_ORG=your-org-name


# --------------------------------
# APPLICATION
# --------------------------------

NODE_ENV=development


# --------------------------------
# SLACK (Socket Mode)
# --------------------------------

SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxx
SLACK_APP_TOKEN=xapp-xxxxxxxxxxxxx
SLACK_SIGNING_SECRET=

# --------------------------------
# NOTION INVITES
# --------------------------------

NOTION_WORKSPACE_INVITE_URL=

# --------------------------------
# GOOGLE DRIVE OAUTH (optional)
# --------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=http://127.0.0.1:53682/oauth2/callback